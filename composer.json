{
    "name": "nvade/numerosis",
    "description": "Multi-tenant SaaS foundation for Laravel: tenancy and billing core, everything else opt-in.",
    "keywords": [
        "nvade",
        "laravel",
        "numerosis",
        "multi-tenancy",
        "saas"
    ],
    "homepage": "https://github.com/Nivade/numerosis",
    "license": "proprietary",
    "authors": [
        {
            "name": "Niels van Deursen",
            "email": "nhavandeursen@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.7",
        "illuminate/auth": "^13.0",
        "illuminate/broadcasting": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/cashier": "^16.1",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.2",
        "lorisleiva/laravel-actions": "^2.9",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-one-time-passwords": "^1.1",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "^7.2",
        "stancl/tenancy": "^v3.9"
    },
    "require-dev": {
        "alizharb/filament-activity-log": "^1.5",
        "internachi/modular": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "ryangjchandler/laravel-cloudflare-turnstile": "^3.0",
        "spatie/laravel-livewire-wizard": "^3.1"
    },
    "suggest": {
        "livewire/flux": "Required by the shipped Flux components used across panel and feature views.",
        "laravel/socialite": "Required by SocialLoginFeature's Socialite login controller.",
        "socialiteproviders/discord": "Socialite provider for Discord login, gated behind SocialLoginFeature same as laravel/socialite.",
        "socialiteproviders/zoho": "Socialite provider for Zoho login, gated behind SocialLoginFeature same as laravel/socialite.",
        "ryangjchandler/laravel-cloudflare-turnstile": "Required by TurnstileFeature's login-form widget.",
        "sentry/sentry-laravel": "Enables TagsSentryScopeWithTenant; guarded by app()->bound('sentry') where used.",
        "laravel/reverb": "Broadcasting/presence-channel support for the tenant panel's realtime features.",
        "pusher/pusher-php-server": "Alternative broadcast driver to laravel/reverb, same broadcasting code paths.",
        "alizharb/filament-activity-log": "Required by ActivityLogFeature's Filament activity-log resource, panel-only.",
        "openplain/filament-shadcn-theme": "Panel theme, follows filament/filament's gate.",
        "dompdf/dompdf": "Required wherever invoice/PDF export is used.",
        "spatie/laravel-livewire-wizard": "Required by RegistrationWizardFeature's registration wizard.",
        "internachi/modular": "The module system PurchaseModule/CancelModule etc. build on; the six concrete modules stay thin-app-only.",
        "mallardduck/blade-lucide-icons": "Icon set used across shipped views."
    },
    "autoload": {
        "psr-4": {
            "Nvade\\Numerosis\\": "src/",
            "Nvade\\Numerosis\\Database\\Factories\\": "database/factories/",
            "Nvade\\Numerosis\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvade\\Numerosis\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "App\\Models\\": "workbench/app/Models/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvade\\Numerosis\\NumerosisServiceProvider"
            ],
            "aliases": {
                "Numerosis": "Nvade\\Numerosis\\Facades\\Numerosis"
            }
        }
    },
    "prefer-stable": true
}
