{
    "name": "nvade/numerosis",
    "description": "Multi-tenant SaaS foundation for Laravel: tenancy and billing core, everything else opt-in.",
    "keywords": [
        "nvade",
        "laravel",
        "numerosis",
        "multi-tenancy",
        "saas"
    ],
    "homepage": "https://github.com/Nivade/numerosis",
    "license": "proprietary",
    "authors": [
        {
            "name": "Niels van Deursen",
            "email": "nhavandeursen@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/cashier": "^16.1",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.21",
        "livewire/livewire": "^4.2",
        "lorisleiva/laravel-actions": "^2.9",
        "nvade/numerosis-ui": "self.version",
        "ryangjchandler/laravel-cloudflare-turnstile": "^3.0",
        "socialiteproviders/discord": "^4.2",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-livewire-wizard": "^3.1",
        "spatie/laravel-one-time-passwords": "^1.1",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "^7.2",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6",
        "sentry/sentry-laravel": "^4.20"
    },
    "suggest": {
        "sentry/sentry-laravel": "Enables TagsSentryScopeWithTenant; guarded by app()->bound('sentry') where used.",
        "laravel/telescope": "Adds a scheduled telescope:prune entry and is why 'telescope/*' is CSRF-exempt; both are class_exists-guarded.",
        "socialiteproviders/zoho": "A Zoho OAuth driver, since Socialite ships none. Which providers exist and which are configured is Enums\\Auth\\SocialProvider, not config."
    },
    "autoload": {
        "psr-4": {
            "Nvade\\Numerosis\\": "src/",
            "Nvade\\Numerosis\\Database\\Factories\\": "database/factories/",
            "Nvade\\Numerosis\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvade\\Numerosis\\Tests\\": "tests/",
            "Nvade\\NumerosisUi\\Tests\\": "packages/ui/tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "App\\Models\\": "workbench/app/Models/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@putenv TESTBENCH_WITHOUT_DEFAULT_MIGRATIONS=true",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv TESTBENCH_WITHOUT_DEFAULT_MIGRATIONS=true",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse",
        "test": "@php -d memory_limit=1G vendor/bin/pest --parallel",
        "test-serial": "@php -d memory_limit=1G vendor/bin/pest",
        "test-browser": "@php -d memory_limit=1G vendor/bin/pest --testsuite=Browser",
        "test-coverage": "@php -d memory_limit=1G vendor/bin/pest --coverage",
        "test:impact": "@php -d memory_limit=1G vendor/bin/pest --dirty",
        "format": "vendor/bin/pint",
        "lint": [
            "@php -d memory_limit=1G vendor/bin/pint --ansi",
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --verbose --ansi"
        ],
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@refactor:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvade\\Numerosis\\NumerosisServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
