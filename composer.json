{
    "name": "nvade/numerosis",
    "description": "Multi-tenant SaaS foundation for Laravel: tenancy and billing core, everything else opt-in.",
    "keywords": [
        "nvade",
        "laravel",
        "numerosis",
        "multi-tenancy",
        "saas"
    ],
    "homepage": "https://github.com/Nivade/numerosis",
    "license": "proprietary",
    "authors": [
        {
            "name": "Niels van Deursen",
            "email": "nhavandeursen@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/broadcasting": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "internachi/modular": "^3.0",
        "laravel/cashier": "^16.1",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.2",
        "lorisleiva/laravel-actions": "^2.9",
        "nvade/numerosis-ui": "@dev",
        "ryangjchandler/laravel-cloudflare-turnstile": "^3.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-livewire-wizard": "^3.1",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "^7.2",
        "stancl/tenancy": "^3.10",
        "torann/geoip": "^3.0"
    },
    "require-dev": {
        "alizharb/filament-activity-log": "^1.5",
        "driftingly/rector-laravel": "^2.5",
        "filament/filament": "^5.7",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "nvade/numerosis-auth-ui": "@dev",
        "nvade/numerosis-filament": "@dev",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.6",
        "sentry/sentry-laravel": "^4.20",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-one-time-passwords": "^1.1"
    },
    "suggest": {
        "nvade/numerosis-auth-ui": "Login, registration, password-reset and OAuth screens. Without it there is no /login, /register or /forgot-password route, the tenant panel falls back to Filament's own login page, and social login is unavailable \u2014 core's auth mechanics (guards, LogoutUser, email verification, the social-account repository) still work.",
        "filament/filament": "Admin + tenant panels (both self-register when installed). Without it, App\\Models\\User loses Filament's FilamentUser/HasTenants contracts and neither panel registers \u2014 everything else still works.",
        "spatie/laravel-one-time-passwords": "Passwordless (OTP) login. Without it, User::HasOneTimePasswordsIfInstalled no-ops and nvade/numerosis-auth-ui's PasswordlessLogin is unreachable.",
        "spatie/laravel-activitylog": "Tenant\\User and Tenant\\Invitation activity logging. Without it, LogsActivityIfInstalled no-ops.",
        "sentry/sentry-laravel": "Enables TagsSentryScopeWithTenant; guarded by app()->bound('sentry') where used.",
        "laravel/telescope": "Adds a scheduled telescope:prune entry and is why 'telescope/*' is CSRF-exempt; both are class_exists-guarded.",
        "laravel/reverb": "Broadcasting/presence-channel support for the tenant panel's realtime features.",
        "pusher/pusher-php-server": "Alternative broadcast driver to laravel/reverb, same broadcasting code paths.",
        "nvade/numerosis-filament": "The admin and tenant Filament panels. Without it this package registers no panels, and filament/filament is not needed at all."
    },
    "autoload": {
        "psr-4": {
            "Nvade\\Numerosis\\": "src/",
            "Nvade\\Numerosis\\Database\\Factories\\": "database/factories/",
            "Nvade\\Numerosis\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvade\\Numerosis\\Tests\\": "tests/",
            "Nvade\\NumerosisUi\\Tests\\": "packages/ui/tests/",
            "Nvade\\NumerosisAuthUi\\Tests\\": "packages/auth-ui/tests/",
            "Nvade\\NumerosisFilament\\Tests\\": "packages/filament/tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "App\\Models\\": "workbench/app/Models/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse",
        "test": "@php -d memory_limit=1G vendor/bin/pest",
        "test-coverage": "@php -d memory_limit=1G vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": [
            "@php -d memory_limit=1G vendor/bin/pint --ansi",
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --verbose --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvade\\Numerosis\\NumerosisServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
