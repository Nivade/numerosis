parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall\:\:expect\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/ArchTest.php

		-
			message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall\:\:expect\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/Feature/ArchTest.php

		-
			message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall\:\:fail\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/Feature/Actions/Tenancy/PromotesOnlyNonBotsTest.php

		-
			message: '#^Call to an undefined method Illuminate\\Testing\\TestResponse\:\:assertSeeLivewire\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/Feature/SettingsProfilePageTest.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: tests/Feature/Boot/NumerosisSeamTest.php

		-
			# `domains()` is Stancl\Tenancy\Database\Concerns\HasDomains, used by
			# Tenant — larastan's relation-existence check doesn't resolve
			# relations pulled in through a trait.
			message: '#^Relation ''domains'' is not found in Nvade\\Numerosis\\Models\\Central\\Tenant model\.$#'
			identifier: larastan.relationExistence
			count: 1
			path: src/Models/Central/CentralUser.php

		-
			message: '#^Relation ''domains'' is not found in Nvade\\Numerosis\\Models\\Central\\Tenant model\.$#'
			identifier: larastan.relationExistence
			count: 1
			path: workbench/app/Models/Central/CentralUser.php

