# Composer Related
composer.lock
/vendor
# packages/* are path-installed from the root; nothing under them is ever
# `composer install`ed in place, but a stray run there must not be committed.
/packages/*/vendor
/packages/*/build

# Frontend Assets
/node_modules

# Logs
npm-debug.log
yarn-error.log

# IDE Helper
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# Editors
/.idea
/.fleet
/.vscode

# Misc
# Local overrides only — the committed configs are the .dist variants.
phpunit.xml
phpstan.neon
/coverage
storage
.DS_Store
Thumbs.db

# Personal, machine-local (Claude Code) — a global ~/.gitconfig excludesfile
# also catches this on most machines, but a fresh clone shouldn't depend on it.
/.claude/settings.local.json

# Testbench workbench (generated by `composer serve` / `testbench.yaml`'s
# build steps — create-sqlite-db, the storage sync). `workbench/storage` is
# already covered by the bare `storage` pattern above.
/workbench/database/database.sqlite
/workbench/bootstrap/cache/*.php
