{
    "name": "nvade/numerosis-auth-ui",
    "description": "Login, registration, password-reset and OAuth screens for Numerosis.",
    "keywords": [
        "nvade",
        "laravel",
        "numerosis",
        "auth",
        "socialite"
    ],
    "homepage": "https://github.com/Nivade/numerosis-auth-ui",
    "license": "proprietary",
    "authors": [
        {
            "name": "Niels van Deursen",
            "email": "nhavandeursen@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/socialite": "^5.21",
        "livewire/livewire": "^4.2",
        "nvade/numerosis": "@dev",
        "nvade/numerosis-ui": "@dev",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/zoho": "^4.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-one-time-passwords": "^1.1"
    },
    "suggest": {
        "spatie/laravel-one-time-passwords": "Passwordless (OTP) login. Without it, PasswordlessLogin is unreachable — nvade/numerosis's HasOneTimePasswordsIfInstalled shim no-ops."
    },
    "autoload": {
        "psr-4": {
            "Nvade\\NumerosisAuthUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvade\\NumerosisAuthUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvade\\NumerosisAuthUi\\NumerosisAuthUiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../numerosis",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../numerosis-ui",
            "options": {
                "symlink": true
            }
        }
    ]
}
