{
    "name": "nvade/numerosis-onboarding",
    "description": "The self-serve tenant registration wizard for Numerosis.",
    "keywords": [
        "nvade",
        "laravel",
        "numerosis",
        "onboarding",
        "registration"
    ],
    "homepage": "https://github.com/Nivade/numerosis-onboarding",
    "license": "proprietary",
    "authors": [
        {
            "name": "Niels van Deursen",
            "email": "nhavandeursen@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.2",
        "nvade/numerosis": "@dev",
        "nvade/numerosis-ui": "@dev",
        "spatie/laravel-livewire-wizard": "^3.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvade\\NumerosisOnboarding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvade\\NumerosisOnboarding\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvade\\NumerosisOnboarding\\NumerosisOnboardingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
