{
    "name": "nvade/numerosis-filament",
    "description": "The admin and tenant Filament panels for Numerosis.",
    "keywords": [
        "nvade",
        "laravel",
        "numerosis",
        "filament"
    ],
    "homepage": "https://github.com/Nivade/numerosis-filament",
    "license": "proprietary",
    "authors": [
        {
            "name": "Niels van Deursen",
            "email": "nhavandeursen@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.7",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.2",
        "nvade/numerosis": "@dev",
        "nvade/numerosis-ui": "@dev",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "alizharb/filament-activity-log": "^1.5",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "alizharb/filament-activity-log": "The audit-log UI in the tenant panel. Without it ActivityLogFeature registers nothing — nvade/numerosis still records activity either way."
    },
    "autoload": {
        "psr-4": {
            "Nvade\\NumerosisFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvade\\NumerosisFilament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvade\\NumerosisFilament\\NumerosisFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
